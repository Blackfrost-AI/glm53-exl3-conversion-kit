# Required: verified full GLM-5.3 DWM BF16 model directory.
SOURCE_DIR=/path/to/GLM-5.3-DWM-s3-BF16

# Required: large local workspace. Output, state, logs, tools and runtime live here.
WORK_ROOT=/path/to/glm53-exl3-work

# Change these only when intentionally adapting the validated recipe.
OUTPUT_NAME=GLM-5.3-DERISKED-EXL3-2.0bpw-HQ
GPU_DEVICES=0,1,2,3,4,5,6,7
SERVE_GPUS=0,1
EXPECTED_SOURCE_SHARDS=161
EXPECTED_OUTPUT_SHARDS=26
SOURCE_INDEX_SHA256=ea558ab1584b518fec4bbc928cfe66018d8c38b0a94c9b8ae336e7fc82b79479
